{
  "info": {
    "name": "Open edX Platform APIs",
    "description": "Tổng hợp 287 API endpoints từ Open edX LMS Platform. Base URL: {{base_url}}/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "edx-platform-api-collection",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/csrf/api/v1/token",
              "host": ["{{base_url}}"],
              "path": ["csrf", "api", "v1", "token"]
            },
            "description": "Lấy CSRF token để sử dụng cho các POST request"
          }
        },
        {
          "name": "Login Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Referer",
                "value": "{{base_url}}/login"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin001\",\n  \"password\": \"123123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/v1/account/login_session/",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "v1", "account", "login_session"]
            },
            "description": "Đăng nhập và tạo session. Lưu ý: Field là 'email' (không phải email_or_username), có thể dùng username hoặc email. Yêu cầu CSRF token và Referer header."
          }
        },
        {
          "name": "Get JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "your_client_id"
                },
                {
                  "key": "client_secret",
                  "value": "your_client_secret"
                },
                {
                  "key": "token_type",
                  "value": "jwt"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth2/v1/access_token",
              "host": ["{{base_url}}"],
              "path": ["oauth2", "v1", "access_token"]
            },
            "description": "Lấy JWT token để xác thực API"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List All Courses",
          "request": {
            "method": "GET",
            "header": [],
