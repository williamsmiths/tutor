              "path": ["api", "courses", "v1", "courses"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                },
                {
                  "key": "active_only",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "org",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "search_term",
                  "value": "",
                  "disabled": true
                }
              ]
